generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DOCTOR
  CLINIC_OWNER
}

enum FacilityType {
  clinic
  hospital
  diagnostic_center
  polyclinic
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  MATCHED
  CLOSED
  REJECTED
}

enum InquiryActivityType {
  INQUIRY_CREATED
  STATUS_CHANGED
  ADMIN_NOTE_ADDED
  ADMIN_UPDATED
  WORKFLOW_EVENT
}

enum ListingModerationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DoctorModerationStatus {
  PENDING
  VERIFIED
  INACTIVE
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(CLINIC_OWNER)
  phone        String?
  specialty    String?
  city         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  createdInquiries Inquiry[]        @relation("InquiryCreatedBy")
  ownedListings    Listing[]        @relation("ListingOwner")
  inquiryActivities InquiryActivity[]
}

model Session {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Listing {
  id           String       @id @default(uuid())
  clinicName   String
  facilityType FacilityType
  city         String
  locality     String
  address      String
  contactPerson String
  phone        String
  email        String
  whatsapp     String
  rooms        Json
  pricing      Json
  availability Json
  infrastructure Json
  specialties  String[]
  images       String[]
  verified     Boolean      @default(false)
  moderationStatus ListingModerationStatus @default(PENDING_REVIEW)
  featured     Boolean      @default(false)
  ownerUserId  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  owner        User?        @relation("ListingOwner", fields: [ownerUserId], references: [id])
  inquiries    Inquiry[]

  @@index([ownerUserId])
  @@index([city, facilityType, verified])
}

model Doctor {
  id                 String   @id @default(uuid())
  fullName           String
  email              String   @unique
  phone              String
  specialty          String
  status             DoctorModerationStatus @default(PENDING)
  experience         Int
  qualification      String
  subSpecialty       String?
  registrationNumber String?
  preferredLocations String[]  @default([])
  consultingTimes    String?
  practiceModel      String?
  website            String?
  linkedin           String?
  affiliations       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Inquiry {
  id         String        @id @default(uuid())
  listing    Listing?      @relation(fields: [listingId], references: [id])
  listingId  String?
  createdBy  User?         @relation("InquiryCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId String?
  doctorName String
  specialty  String        @default("")
  email      String
  phone      String
  message    String
  status     InquiryStatus @default(NEW)
  adminNotes String?
  contactedAt DateTime?
  discussionStartedAt DateTime?
  matchedAt DateTime?
  closedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  activities InquiryActivity[]

  @@index([createdByUserId])
  @@index([listingId, status])
}

model InquiryActivity {
  id          String              @id @default(uuid())
  inquiry     Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  inquiryId   String
  actorUser   User?               @relation(fields: [actorUserId], references: [id])
  actorUserId String?
  type        InquiryActivityType
  title       String
  description String?
  fromStatus  InquiryStatus?
  toStatus    InquiryStatus?
  metadata    Json?
  createdAt   DateTime            @default(now())

  @@index([inquiryId, createdAt])
  @@index([type, createdAt])
}
